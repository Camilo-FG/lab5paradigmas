    "jest": "^30.5.2",
    "snyk": "^1.1308.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "ws": "^8.21.3",
    "socket.io-parser": "^4.2.7"
  }
}
